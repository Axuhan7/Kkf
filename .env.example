; Copy to project root as `.env` and fill in real values.
; Values with : / special chars must be quoted (ThinkPHP uses parse_ini_file).

; ---- Database ----
DB_HOST = "127.0.0.1"
DB_PORT = "3306"
DB_DATABASE = "your_database"
DB_USERNAME = "your_user"
DB_PASSWORD = "change_me"

; ---- Site (no trailing slash) ----
APP_DOMAIN = "https://your-domain.com"

; ---- Pusher ----
PUSHER_APP_KEY = ""
PUSHER_APP_SECRET = ""
PUSHER_APP_ID = "232"
PUSHER_WHOST = "wss://your-domain.com"
PUSHER_WPORT = "2081"
PUSHER_AHOST = "http://127.0.0.1"
PUSHER_APORT = "2082"
PUSHER_SSL_CERT = ""
PUSHER_SSL_PK = ""

; ---- Security ----
YMWL_SALT = ""
REGIST_TOKEN = ""
API_ACCESS_TOKEN = ""
